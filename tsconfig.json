{
  "compilerOptions": {
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "checkJs": false,
    "esModuleInterop": true,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2020"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2020",
    "types": [
      "node",
      "bun"
    ]
  },
  "exclude": [
    "dist",
    "node_modules",
    "native"
  ],
  "extends": "./.trebired/code-discipline/generated/tsconfig.paths.json",
  "include": [
    "src/**/*.ts",
    ".trebired/**/*.ts",
    "scripts/**/*.ts"
  ]
}
